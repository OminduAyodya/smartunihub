{
  "name": "smartunihub",
  "version": "1.0.0",
  "description": "SmartUniHub - Canteen Management System",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=frontend\" \"npm run dev --workspace=admin\" \"npm run dev --workspace=backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend-admin": "concurrently \"npm run dev --workspace=frontend\" \"npm run dev --workspace=admin\"",
    "build": "npm run build --workspace=frontend && npm run build --workspace=admin",
    "build:frontend": "npm run build --workspace=frontend",
    "build:admin": "npm run build --workspace=admin"
  },
  "workspaces": [
    "frontend",
    "admin",
    "backend"
  ],
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
